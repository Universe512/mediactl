ROOT_DOMAIN=example.com
DASHBOARD_SUBDOMAIN=media
CLOUDFLARE_TUNNEL_TOKEN=paste-your-tunnel-token-here

# Direct LAN access. Use the LXC's LAN IP to make it reachable by other devices.
# Generate the token with: openssl rand -hex 32
LOCAL_BIND_ADDRESS=127.0.0.1
LOCAL_PORT=8088
LOCAL_ACCESS_TOKEN=replace-with-a-long-random-token

# Keep this true. Local access uses LOCAL_ACCESS_TOKEN instead of bypassing auth.
REQUIRE_CF_ACCESS=true
